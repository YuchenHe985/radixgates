# RadixGates local configuration template
# Copy this file to .env and fill in the real values: cp .env.example .env
#
# .env is ignored by git and must not be committed.

# ──────────────────────────────────────────
# SSH_TARGET
# ──────────────────────────────────────────
# When the demo scripts (pd_demo.py / enterprise_qa_demo.py / streaming_demo.py)
# run on a local workstation, they can connect to the remote GPU host over SSH
# and copy container logs into the local examples/logs/ directory.
#
# Format: user@host:port
#   user  — SSH login user (often root)
#   host  — public IP address or DNS name of the GPU host
#   port  — SSH port (22 by default; cloud hosts may use a custom port)
#
# Example:
#   SSH_TARGET=root@203.0.113.10:22
#   SSH_TARGET=root@203.0.113.10:22
#
SSH_TARGET=root@<server-ip>:<ssh-port>
